# =============================================================================
# RobotUniversityGiar — Docker Compose Environment Variables (SAMPLE)
# =============================================================================
# Copy this file to .env and edit the values for your machine:
#
#   cp .env.sample .env
#
# The .env file is git-ignored so local paths / secrets never leak into the
# repository.
# =============================================================================

# ---------------------------------------------------------------------------
# Genesis backend: "cpu" or "cuda"
# ---------------------------------------------------------------------------
# "cuda"  → tries GPU acceleration; falls back to CPU automatically if the
#           NVIDIA runtime is unavailable.
# "cpu"   → forces CPU-only mode (works on any machine, including Apple
#           Silicon and headless servers without a GPU).
# ---------------------------------------------------------------------------
GENESIS_BACKEND=cuda

# ---------------------------------------------------------------------------
# GPU selection
# ---------------------------------------------------------------------------
# Which host GPU the container sees.  Use an integer index (0, 1, 2, …)
# or a comma-separated list.  Only effective when the GPU overlay
# (docker-compose.gpu.yml) is applied.
#
#   CUDA_VISIBLE_DEVICES=0      → first GPU only
#   CUDA_VISIBLE_DEVICES=2      → third GPU only (useful when GPU 0/1 are busy)
#   CUDA_VISIBLE_DEVICES=0,1    → expose both GPUs to the container
# ---------------------------------------------------------------------------
CUDA_VISIBLE_DEVICES=0

# ---------------------------------------------------------------------------
# Number of parallel environments
# ---------------------------------------------------------------------------
# Default for training commands run inside the container.  The upstream
# default is 4096, which needs ~16 GB+ of VRAM.  If you get
# "CUDA_ERROR_OUT_OF_MEMORY" at startup, lower this value.
#
#   NUM_ENVS=4096   → full throughput on a 24 GB+ card
#   NUM_ENVS=2048   → safer default for 12–16 GB cards
#   NUM_ENVS=1024   → very conservative, good for debugging
#
# Usage inside the container:
#   docker compose run --rm leggedgym python -m legged_gym.scripts.train --task go2 --num_envs $NUM_ENVS
# ---------------------------------------------------------------------------
NUM_ENVS=2048

# ---------------------------------------------------------------------------
# Active policy
# ---------------------------------------------------------------------------
# Must match a folder name under ./policies/ that contains checkpoint.pt
# (e.g. ./policies/stable/). Discovered at runtime by the Python side;
# if left blank, the first folder alphabetically is chosen automatically.
# ---------------------------------------------------------------------------
ACTIVE_POLICY=stable

# ---------------------------------------------------------------------------
# Network ports exposed to the host
# ---------------------------------------------------------------------------
# Change these only if the default ports are already in use.
#   CONTROL_PORT → FastAPI unified control web + WebSocket bridge
#   VISER_PORT   → viser 3-D web viewer
# ---------------------------------------------------------------------------
CONTROL_PORT=9013
VISER_PORT=9006

# ---------------------------------------------------------------------------
# Headless / smoke-test mode
# ---------------------------------------------------------------------------
# Set to 1 to disable the web viewer and run a short autonomous switch test
# instead.  Useful for CI or verifying that the container still imports and
# steps correctly after a code change.
# ---------------------------------------------------------------------------
HEADLESS=0

# ---------------------------------------------------------------------------
# Simulation playback speed
# ---------------------------------------------------------------------------
# Multiplier for the control loop.  1.0 = real-time (50 Hz).  Lower values
# slow the simulation so it is easier to follow on a slow machine.
# ---------------------------------------------------------------------------
SPEED=0.35
