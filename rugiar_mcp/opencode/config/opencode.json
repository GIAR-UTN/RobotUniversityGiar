{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "local": {
      "name": "Local Server",
      "npm": "@ai-sdk/openai-compatible",
      "options": { "baseURL": "http://host.docker.internal:9932/v1" },
      "models": { "local_model": { "name": "Local Model" } },
      "attachment": true,
      "modalities": {
            "input": ["text", "image"]
          }
    }
  },
  "mcp": {
    "rugiar-mcp": {
      "type": "remote",
      "url": "http://mcp:9014/mcp",
      "enabled": true
    }
  }
}